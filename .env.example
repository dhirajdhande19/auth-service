# PORT
PORT=4000

# JWT
# IMP Note: 
# (JWT_SECRET_ACCESS_TOKEN != JWT_SECRET_REFRESH_TOKEN) && (JWT_EXPIRES_IN_ACCESS_TOKEN < JWT_EXPIRES_IN_REFRESH_TOKEN)
# Access Token
JWT_SECRET_ACCESS_TOKEN=your-access_token-secret-key
JWT_EXPIRES_IN_ACCESS_TOKEN=20s
# Refresh Token
JWT_SECRET_REFRESH_TOKEN=your-refresh_token-secret-key
JWT_EXPIRES_IN_REFRESH_TOKEN=7d

# Redis
REDIS_URL='your-redis-url'

# Redis expire refresh token (REDIS_EXPIRE_REFRESH_TOKEN - in days) 
# -> Must be same as JWT_EXPIRES_IN_REFRESH_TOKEN (in number only)
REDIS_EXPIRE_REFRESH_TOKEN=7

# OAuth 2.0
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_REDIRECT_URI="http://localhost:4000/api/auth/google/callback"
GOOGLE_CLIENT_SECRET=your-google-client-secret
# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_REDIRECT_URI="http://localhost:4000/api/auth/github/callback"
GITHUB_CLIENT_SECRET=your-github-client-secret